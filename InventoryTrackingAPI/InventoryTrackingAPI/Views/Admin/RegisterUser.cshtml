@{
    ViewData["Title"] = "Provision New User";
}

<div style="font-family: sans-serif; padding: 20px; max-width: 600px;">

    <<!-- UNIVERSAL NAVIGATION MENU -->
    <div style="margin-bottom: 20px; padding: 15px; background-color: #f8f9fa; border-radius: 5px; border: 1px solid #ddd; display: flex; gap: 15px;">
        <a href="/Admin/Dashboard" style="text-decoration: none; font-weight: bold; color: #333;">📊 Audit Logs</a>
        <a href="/Admin/Inventory" style="text-decoration: none; font-weight: bold; color: #333;">📦 Master Inventory</a>
        <a href="/Admin/AddAsset" style="text-decoration: none; font-weight: bold; color: #333;">+ Register New Asset</a>
        <a href="/Admin/RegisterUser" style="text-decoration: none; font-weight: bold; color: #333;">👤 Add User</a>
        <a href="/Admin/UserDirectory" style="text-decoration: none; font-weight: bold; color: #007bff;">👥 User Directory</a>
        <!-- THE WELCOME MESSAGE -->
        <span style="margin-left: auto; font-style: italic; color: #555;">Welcome, @User.Identity?.Name!</span>
        <a href="/Admin/Logout" style="color: red; margin-left: auto; text-decoration: none; font-weight: bold;">Logout</a>
    </div>

    <h2>Provision New System User</h2>
    <p>Create a secure account for a new employee. Passwords are automatically salted and hashed.</p>

    @if (ViewBag.Error != null)
    {
        <p style="color: red; font-weight: bold;">@ViewBag.Error</p>
    }

    <form method="post" action="/Admin/RegisterUser" style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">

        <div>
            <label style="font-weight: bold;">Employee Username:</label><br />
            <input type="text" name="username" required style="padding: 8px; width: 100%; border: 1px solid #ccc; border-radius: 4px;" />
        </div>

        <div>
            <label style="font-weight: bold;">Temporary Password:</label><br />
            <input type="password" name="password" required style="padding: 8px; width: 100%; border: 1px solid #ccc; border-radius: 4px;" />
        </div>

        <div>
            <label style="font-weight: bold;">System Role:</label><br />
            <select name="role" required style="padding: 8px; width: 100%; border: 1px solid #ccc; border-radius: 4px;">
                <option value="Technician">Field Technician (Mobile App Access)</option>
                <option value="Admin">Administrator (Dashboard Access)</option>
            </select>
        </div>

        <button type="submit" style="padding: 10px; background-color: #28a745; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; margin-top: 10px;">
            Provision User
        </button>
    </form>
</div>