@model InventoryTrackingAPI.Models.Asset
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Edit Asset";
}

<div style="font-family: sans-serif; padding: 20px;">
    <!-- UNIVERSAL NAVIGATION MENU       -->
    <div style="margin-bottom: 20px; padding: 15px; background-color: #f8f9fa; border-radius: 5px; border: 1px solid #ddd; display: flex; gap: 15px; align-items: center;">
        <a href="/Admin/Dashboard" style="text-decoration: none; font-weight: bold; color: #333;">📊 Audit Logs</a>
        <a href="/Admin/Inventory" style="text-decoration: none; font-weight: bold; color: #333;">📦 Master Inventory</a>
        <a href="/Admin/AddAsset" style="text-decoration: none; font-weight: bold; color: #333;">+ Register New Asset</a>
        <a href="/Admin/RegisterUser" style="text-decoration: none; font-weight: bold; color: #333;">👤 Add User</a>
        <a href="/Admin/UserDirectory" style="text-decoration: none; font-weight: bold; color: #007bff;">👥 User Directory</a>

        <span style="margin-left: auto; font-style: italic; color: #555;">Welcome, @User.Identity?.Name!</span>
        <a href="/Admin/Logout" style="color: red; margin-left: auto; text-decoration: none; font-weight: bold;">Logout</a>
    </div>

    <h2>Edit Asset #@Model.AssetId</h2>

    <!-- STYLED FORM CONTAINER -->
    <div style="max-width: 600px; background-color: #ffffff; padding: 25px; border-radius: 8px; border: 1px solid #ddd; margin-top: 20px;">
        <form asp-action="EditAsset" method="post">
            <!-- CRITICAL: Hidden fields so EF Core knows which row to update -->
            <input type="hidden" asp-for="AssetId" />
            <input type="hidden" asp-for="BaselineHash" />

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px; color: #333;">Barcode (S/N)</label>
                <input asp-for="SerialNumber" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" />
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px; color: #333;">Category</label>
                <input asp-for="Category" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" />
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px; color: #333;">Specifications</label>
                <input asp-for="Specifications" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" />
            </div>

            <div style="margin-bottom: 25px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px; color: #333;">Status</label>
                <select asp-for="Status" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; background-color: white;">
                    <option value="Active">Active</option>
                    <option value="Tampered">Tampered</option>
                    <option value="Missing">Missing</option>
                    <option value="Maintenance">Maintenance</option>
                    <option value="Removed">Removed</option>
                </select>
            </div>

            <div style="display: flex; gap: 10px;">
                <button type="submit" style="padding: 10px 20px; background-color: #28a745; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">Save Changes</button>
                <a href="/Admin/Inventory" style="padding: 10px 20px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; text-align: center;">Cancel</a>
            </div>
        </form>
    </div>
</div>