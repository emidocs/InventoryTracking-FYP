@{
    ViewData["Title"] = "System Login";
    Layout = null; // Hides the standard layout so they don't see the navigation bar
}
<div style="font-family: sans-serif; max-width: 400px; margin: 100px auto; padding: 20px; border: 1px solid #ccc; border-radius: 5px; text-align: center;">
    <h2>Zero Trust Dashboard</h2>
    @if (ViewBag.Error != null)
    {
        <p style="color: red; font-weight: bold;">@ViewBag.Error</p>
    }
    <form method="post" action="/Admin/Login" style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
        <input type="text" name="username" placeholder="Username" required style="padding: 10px; border-radius: 4px; border: 1px solid #ccc;" />
        <input type="password" name="password" placeholder="Password" required style="padding: 10px; border-radius: 4px; border: 1px solid #ccc;" />
        <button type="submit" style="padding: 10px; background-color: #000; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">Login</button>
    </form>
</div>