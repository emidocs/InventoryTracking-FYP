@{
    ViewData["Title"] = "Technician Portal";
    Layout = null;
}

<div style="font-family: sans-serif; max-width: 600px; margin: 50px auto; padding: 20px; text-align: center; border: 1px solid #ddd; border-radius: 8px; background-color: #f8f9fa;">
    <h2 style="color: #333;">Welcome, @User.Identity?.Name!</h2>
    <p style="color: #666; margin-bottom: 30px;">Your account is provisioned for mobile field access.</p>

    <div style="padding: 20px; background-color: white; border: 1px solid #ccc; border-radius: 8px;">
        <h3 style="margin-top: 0;">📱 Mobile Scanner App</h3>
        <p>Please download and install the latest APK to begin verifying hardware integrity.</p>

        <!-- You can place your actual compiled .apk file in the wwwroot folder later! -->
        <a href="#" style="display: inline-block; padding: 12px 24px; background-color: #007bff; color: white; text-decoration: none; font-weight: bold; border-radius: 4px; margin: 15px 0;">
            ⬇️ Download Scanner APK
        </a>
    </div>

    <div style="margin-top: 30px;">
        <a href="/Technician/Logout" style="color: red; font-weight: bold; text-decoration: none;">Sign Out</a>
    </div>
</div>